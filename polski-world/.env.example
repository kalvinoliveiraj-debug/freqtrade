# Copy to `.env` (or set in your shell) for the AI conversation partner.
# The app reads EXPO_PUBLIC_* vars at build time.
#
# URL of YOUR backend proxy (see server/ai-proxy.mjs). The Anthropic API key
# stays on the server — never put it here, this value ships in the app bundle.
EXPO_PUBLIC_AI_PROXY_URL=

# Server-only (used by server/ai-proxy.mjs, NOT by the app):
# ANTHROPIC_API_KEY=sk-ant-...
